# Rust workspace (rust/)
rust/target/
rust/**/target/
**/*.rs.bk
.cargo/
# Keep rust/Cargo.lock committed (app, not library)

# cbindgen output is generated — never hand-edit, never commit.
# Built by veronica-ffi build.rs (cbindgen) into the crate include dir so
# Xcode HEADER_SEARCH_PATHS stays fixed; `cargo build -p veronica-ffi`
# refreshes it alongside target/debug/libveronica.a.
rust/crates/veronica-ffi/include/veronica.h

# Fastlane / notarization artifacts
*.dmg
*.pkg

# Env / secrets
.env
.env.*
!.env.example

.tmp/
